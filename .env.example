NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://austral:austral@localhost:5432/austral_ledger
REDIS_URL=redis://localhost:6379
# At least 32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEY_PEPPER=change-me-to-a-random-string-of-32-chars-or-more
DB_POOL_MAX=10
LOG_LEVEL=info
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_TTL_MS=30000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100
RATE_LIMIT_POST_MAX=30
RATE_LIMIT_IP_MAX=300
TRUST_PROXY_HOPS=0

# Used by compose.yaml for the postgres service
POSTGRES_USER=austral
POSTGRES_PASSWORD=austral
POSTGRES_DB=austral_ledger

# Host port for the api container (change if 3000 is busy)
API_HOST_PORT=3000
