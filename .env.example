NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://austral:austral@localhost:5432/austral_ledger
REDIS_URL=redis://localhost:6379
# At least 32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEY_PEPPER=change-me-to-a-random-string-of-32-chars-or-more
DB_POOL_MAX=10
LOG_LEVEL=info
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_TTL_MS=30000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100
RATE_LIMIT_POST_MAX=30
RATE_LIMIT_IP_MAX=300
TRUST_PROXY_HOPS=0
# AES-256 key for webhook secrets (32 bytes, base64); replace this all-zero placeholder. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEBHOOK_SECRET_KEY=replace-me
# Dev/tests only: allow http and private, loopback or link-local webhook targets.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
OUTBOX_POLL_MS=1000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_MS=5000
# Port of the worker's /metrics endpoint
WORKER_METRICS_PORT=9464

# Used by compose.yaml for the postgres service
POSTGRES_USER=austral
POSTGRES_PASSWORD=austral
POSTGRES_DB=austral_ledger

# Host port for the api container (change if 3000 is busy)
API_HOST_PORT=3000
