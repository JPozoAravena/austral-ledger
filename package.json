{
  "name": "austral-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Double-entry wallet ledger API for Monedero Austral SpA",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run test/e2e"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.0",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.1"
  },
  "type": "module"
}
